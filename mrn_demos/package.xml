<?xml version="1.0"?>
<package format="3">
  <name>mrn_demos</name>
  <version>0.1.0</version>
  <description>Launch files and scenarios for multirobot-navigation demos.</description>
  <maintainer email="maintainers@example.com">multirobot-navigation maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>mrn_comm</exec_depend>
  <exec_depend>mrn_eval</exec_depend>
  <exec_depend>mrn_gnss</exec_depend>
  <exec_depend>mrn_graph</exec_depend>
  <exec_depend>mrn_msgs</exec_depend>
  <exec_depend>mrn_nav2_adapter</exec_depend>
  <exec_depend>mrn_netem</exec_depend>
  <exec_depend>mrn_viz</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
