<?xml version="1.0"?>
<package format="3">
  <name>mrn_gazebo</name>
  <version>0.1.0</version>
  <description>Optional Gazebo (gz sim) adapter for multirobot-navigation: bridge model poses into AgentState so the stack can use a Gazebo world as the plant. Requires Gazebo; not exercised in CI.</description>
  <maintainer email="maintainers@example.com">multirobot-navigation maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>mrn_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
