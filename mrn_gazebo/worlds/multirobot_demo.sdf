<?xml version="1.0" ?>
<!--
  Gazebo (gz sim, Harmonic) demo world for the README/docs video: three robots
  cross a bounded arena of cylindrical obstacles, driven over cmd_vel by the
  repo's own navigation stack (scripts/record_gazebo_gif.py). Each robot moves
  via the kinematic VelocityControl system (a commanded body twist -> motion,
  stable and slip-free). A static, isometric camera sensor renders the scene and
  the CameraVideoRecorder / image topic feed it to the recorder script entirely
  offscreen (no GUI, no desktop window) on the GPU.

  Optional: requires Gazebo. Not exercised in CI; this is media-generation only.
-->
<sdf version="1.8">
  <world name="multirobot_demo">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <!-- Offscreen rendering for the recording camera (no GUI, no desktop). -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
      <background_color>0.043 0.055 0.078 1</background_color>
    </plugin>

    <scene>
      <ambient>0.5 0.5 0.55 1</ambient>
      <background>0.043 0.055 0.078 1</background>
      <grid>false</grid>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>-0.4 0.3 -0.9</direction>
    </light>
    <light type="point" name="fill">
      <pose>6 4 8 0 0 0</pose>
      <diffuse>0.35 0.4 0.5 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>40</range><linear>0.02</linear><quadratic>0.002</quadratic></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material><ambient>0.05 0.07 0.10 1</ambient><diffuse>0.07 0.09 0.13 1</diffuse><specular>0.02 0.02 0.03 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- Obstacles (mirror the sim_demo layout, scaled to the 12x8 arena). -->
    <model name="obstacle_a">
      <static>true</static><pose>6 4 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>1.3</radius><length>1</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>1.3</radius><length>1</length></cylinder></geometry>
          <material><ambient>0.29 0.33 0.40 1</ambient><diffuse>0.33 0.37 0.44 1</diffuse></material></visual>
      </link>
    </model>
    <model name="obstacle_b">
      <static>true</static><pose>3 5.5 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.8</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.8</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.29 0.33 0.40 1</ambient><diffuse>0.33 0.37 0.44 1</diffuse></material></visual>
      </link>
    </model>
    <model name="obstacle_c">
      <static>true</static><pose>9 5.5 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.9</radius><length>0.9</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.9</radius><length>0.9</length></cylinder></geometry>
          <material><ambient>0.29 0.33 0.40 1</ambient><diffuse>0.33 0.37 0.44 1</diffuse></material></visual>
      </link>
    </model>
    <model name="obstacle_d">
      <static>true</static><pose>8.5 2.2 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.7</radius><length>0.7</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.7</radius><length>0.7</length></cylinder></geometry>
          <material><ambient>0.29 0.33 0.40 1</ambient><diffuse>0.33 0.37 0.44 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ROBOT 1 (cyan) -->
    <model name="robot_1">
      <pose>1 1 0.1 0 0 0</pose>
      <link name="base">
        <inertial><mass>2.0</mass><inertia><ixx>0.05</ixx><iyy>0.05</iyy><izz>0.08</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><pose>0 0 0.12 0 0 0</pose><geometry><box><size>0.5 0.3 0.2</size></box></geometry></collision>
        <collision name="caster_front"><pose>0.2 0 -0.05 0 0 0</pose><geometry><sphere><radius>0.05</radius></sphere></geometry>
          <surface><friction><ode><mu>0.4</mu><mu2>0.4</mu2></ode></friction></surface></collision>
        <collision name="caster_rear"><pose>-0.2 0 -0.05 0 0 0</pose><geometry><sphere><radius>0.05</radius></sphere></geometry>
          <surface><friction><ode><mu>0.4</mu><mu2>0.4</mu2></ode></friction></surface></collision>
        <visual name="visual"><pose>0 0 0.12 0 0 0</pose><geometry><box><size>0.5 0.3 0.2</size></box></geometry>
          <material><ambient>0.13 0.55 0.77 1</ambient><diffuse>0.22 0.74 0.93 1</diffuse><specular>0.3 0.3 0.3 1</specular></material></visual>
        <visual name="nose"><pose>0.22 0 0.18 0 0 0</pose><geometry><box><size>0.1 0.18 0.1</size></box></geometry>
          <material><ambient>0.9 0.95 1 1</ambient><diffuse>0.9 0.95 1 1</diffuse></material></visual>
        <visual name="lidar_puck"><pose>0 0 0.30 0 0 0</pose><geometry><cylinder><radius>0.06</radius><length>0.08</length></cylinder></geometry>
          <material><ambient>0.05 0.06 0.08 1</ambient><diffuse>0.08 0.09 0.11 1</diffuse></material></visual>
        <sensor name="lidar" type="gpu_lidar"><pose>0 0 0.34 0 0 0</pose>
          <update_rate>15</update_rate><always_on>1</always_on><topic>/model/robot_1/scan</topic>
          <lidar><scan><horizontal><samples>120</samples><resolution>1</resolution>
              <min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
            <range><min>0.12</min><max>6.0</max><resolution>0.01</resolution></range></lidar>
        </sensor>
      </link>
      <link name="left_wheel"><pose>0 0.18 0 -1.5707 0 0</pose>
        <inertial><mass>0.2</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry><material><ambient>0.1 0.1 0.12 1</ambient><diffuse>0.12 0.12 0.14 1</diffuse></material></visual></link>
      <link name="right_wheel"><pose>0 -0.18 0 -1.5707 0 0</pose>
        <inertial><mass>0.2</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry><material><ambient>0.1 0.1 0.12 1</ambient><diffuse>0.12 0.12 0.14 1</diffuse></material></visual></link>
      <joint name="left_wheel_joint" type="revolute"><parent>base</parent><child>left_wheel</child><axis><xyz>0 1 0</xyz></axis></joint>
      <joint name="right_wheel_joint" type="revolute"><parent>base</parent><child>right_wheel</child><axis><xyz>0 1 0</xyz></axis></joint>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <topic>/model/robot_1/cmd_vel</topic></plugin>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose><publish_model_pose>true</publish_model_pose>
        <use_pose_vector_msg>false</use_pose_vector_msg><static_publisher>false</static_publisher>
        <update_frequency>30</update_frequency></plugin>
    </model>

    <!-- ROBOT 2 (pink) -->
    <model name="robot_2">
      <pose>11 1 0.1 0 0 3.14159</pose>
      <link name="base">
        <inertial><mass>2.0</mass><inertia><ixx>0.05</ixx><iyy>0.05</iyy><izz>0.08</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><pose>0 0 0.12 0 0 0</pose><geometry><box><size>0.5 0.3 0.2</size></box></geometry></collision>
        <collision name="caster_front"><pose>0.2 0 -0.05 0 0 0</pose><geometry><sphere><radius>0.05</radius></sphere></geometry>
          <surface><friction><ode><mu>0.4</mu><mu2>0.4</mu2></ode></friction></surface></collision>
        <collision name="caster_rear"><pose>-0.2 0 -0.05 0 0 0</pose><geometry><sphere><radius>0.05</radius></sphere></geometry>
          <surface><friction><ode><mu>0.4</mu><mu2>0.4</mu2></ode></friction></surface></collision>
        <visual name="visual"><pose>0 0 0.12 0 0 0</pose><geometry><box><size>0.5 0.3 0.2</size></box></geometry>
          <material><ambient>0.78 0.30 0.55 1</ambient><diffuse>0.96 0.45 0.71 1</diffuse><specular>0.3 0.3 0.3 1</specular></material></visual>
        <visual name="nose"><pose>0.22 0 0.18 0 0 0</pose><geometry><box><size>0.1 0.18 0.1</size></box></geometry>
          <material><ambient>1 0.95 0.97 1</ambient><diffuse>1 0.95 0.97 1</diffuse></material></visual>
        <visual name="lidar_puck"><pose>0 0 0.30 0 0 0</pose><geometry><cylinder><radius>0.06</radius><length>0.08</length></cylinder></geometry>
          <material><ambient>0.05 0.06 0.08 1</ambient><diffuse>0.08 0.09 0.11 1</diffuse></material></visual>
        <sensor name="lidar" type="gpu_lidar"><pose>0 0 0.34 0 0 0</pose>
          <update_rate>15</update_rate><always_on>1</always_on><topic>/model/robot_2/scan</topic>
          <lidar><scan><horizontal><samples>120</samples><resolution>1</resolution>
              <min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
            <range><min>0.12</min><max>6.0</max><resolution>0.01</resolution></range></lidar>
        </sensor>
      </link>
      <link name="left_wheel"><pose>0 0.18 0 -1.5707 0 0</pose>
        <inertial><mass>0.2</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry><material><ambient>0.1 0.1 0.12 1</ambient><diffuse>0.12 0.12 0.14 1</diffuse></material></visual></link>
      <link name="right_wheel"><pose>0 -0.18 0 -1.5707 0 0</pose>
        <inertial><mass>0.2</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry><material><ambient>0.1 0.1 0.12 1</ambient><diffuse>0.12 0.12 0.14 1</diffuse></material></visual></link>
      <joint name="left_wheel_joint" type="revolute"><parent>base</parent><child>left_wheel</child><axis><xyz>0 1 0</xyz></axis></joint>
      <joint name="right_wheel_joint" type="revolute"><parent>base</parent><child>right_wheel</child><axis><xyz>0 1 0</xyz></axis></joint>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <topic>/model/robot_2/cmd_vel</topic></plugin>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose><publish_model_pose>true</publish_model_pose>
        <use_pose_vector_msg>false</use_pose_vector_msg><static_publisher>false</static_publisher>
        <update_frequency>30</update_frequency></plugin>
    </model>

    <!-- ROBOT 3 (green) -->
    <model name="robot_3">
      <pose>1 7 0.1 0 0 -1.5707</pose>
      <link name="base">
        <inertial><mass>2.0</mass><inertia><ixx>0.05</ixx><iyy>0.05</iyy><izz>0.08</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><pose>0 0 0.12 0 0 0</pose><geometry><box><size>0.5 0.3 0.2</size></box></geometry></collision>
        <collision name="caster_front"><pose>0.2 0 -0.05 0 0 0</pose><geometry><sphere><radius>0.05</radius></sphere></geometry>
          <surface><friction><ode><mu>0.4</mu><mu2>0.4</mu2></ode></friction></surface></collision>
        <collision name="caster_rear"><pose>-0.2 0 -0.05 0 0 0</pose><geometry><sphere><radius>0.05</radius></sphere></geometry>
          <surface><friction><ode><mu>0.4</mu><mu2>0.4</mu2></ode></friction></surface></collision>
        <visual name="visual"><pose>0 0 0.12 0 0 0</pose><geometry><box><size>0.5 0.3 0.2</size></box></geometry>
          <material><ambient>0.51 0.74 0.16 1</ambient><diffuse>0.64 0.90 0.21 1</diffuse><specular>0.3 0.3 0.3 1</specular></material></visual>
        <visual name="nose"><pose>0.22 0 0.18 0 0 0</pose><geometry><box><size>0.1 0.18 0.1</size></box></geometry>
          <material><ambient>0.97 1 0.92 1</ambient><diffuse>0.97 1 0.92 1</diffuse></material></visual>
        <visual name="lidar_puck"><pose>0 0 0.30 0 0 0</pose><geometry><cylinder><radius>0.06</radius><length>0.08</length></cylinder></geometry>
          <material><ambient>0.05 0.06 0.08 1</ambient><diffuse>0.08 0.09 0.11 1</diffuse></material></visual>
        <sensor name="lidar" type="gpu_lidar"><pose>0 0 0.34 0 0 0</pose>
          <update_rate>15</update_rate><always_on>1</always_on><topic>/model/robot_3/scan</topic>
          <lidar><scan><horizontal><samples>120</samples><resolution>1</resolution>
              <min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
            <range><min>0.12</min><max>6.0</max><resolution>0.01</resolution></range></lidar>
        </sensor>
      </link>
      <link name="left_wheel"><pose>0 0.18 0 -1.5707 0 0</pose>
        <inertial><mass>0.2</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry><material><ambient>0.1 0.1 0.12 1</ambient><diffuse>0.12 0.12 0.14 1</diffuse></material></visual></link>
      <link name="right_wheel"><pose>0 -0.18 0 -1.5707 0 0</pose>
        <inertial><mass>0.2</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry><material><ambient>0.1 0.1 0.12 1</ambient><diffuse>0.12 0.12 0.14 1</diffuse></material></visual></link>
      <joint name="left_wheel_joint" type="revolute"><parent>base</parent><child>left_wheel</child><axis><xyz>0 1 0</xyz></axis></joint>
      <joint name="right_wheel_joint" type="revolute"><parent>base</parent><child>right_wheel</child><axis><xyz>0 1 0</xyz></axis></joint>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <topic>/model/robot_3/cmd_vel</topic></plugin>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose><publish_model_pose>true</publish_model_pose>
        <use_pose_vector_msg>false</use_pose_vector_msg><static_publisher>false</static_publisher>
        <update_frequency>30</update_frequency></plugin>
    </model>

    <!-- Recording camera: a static, isometric viewpoint over the arena. It
         publishes frames on the gz topic /rec_camera (which the recorder script
         bridges to ROS and encodes); the CameraVideoRecorder plugin is wired in
         too, so `gz service -s /rec_camera/record ...` can alternatively dump a
         video file server-side. Either way recording is fully offscreen. -->
    <model name="rec_camera">
      <static>true</static>
      <pose>6 -7.2 9.2 0 0.66 1.5707</pose>
      <link name="link">
        <sensor name="rec" type="camera">
          <camera>
            <horizontal_fov>0.92</horizontal_fov>
            <image><width>1000</width><height>700</height></image>
            <clip><near>0.1</near><far>100</far></clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <topic>rec_camera</topic>
          <plugin filename="gz-sim-camera-video-recorder-system" name="gz::sim::systems::CameraVideoRecorder">
            <service>/rec_camera/record</service>
            <use_sim_time>true</use_sim_time>
            <fps>30</fps>
          </plugin>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
