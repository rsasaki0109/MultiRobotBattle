<?xml version="1.0" ?>
<!--
  Gazebo (gz sim, Harmonic) ORCA crowd demo world: two interleaved streams of
  holonomic robots (4 heading right, 4 heading left) on near-head-on lanes that
  must pass through each other. Driven over cmd_vel by mrn_coord.orca (reciprocal
  collision avoidance) via scripts/record_gazebo_orca_gif.py; each moves with the
  kinematic VelocityControl system. A static camera sensor renders it fully
  offscreen. Media-generation only; not in CI.
-->
<sdf version="1.8">
  <world name="orca_demo">
    <physics name="1ms" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine><background_color>0.043 0.055 0.078 1</background_color></plugin>

    <scene><ambient>0.5 0.5 0.55 1</ambient><background>0.043 0.055 0.078 1</background><grid>false</grid><shadows>true</shadows></scene>
    <light type="directional" name="sun"><cast_shadows>true</cast_shadows><pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse><specular>0.25 0.25 0.25 1</specular><direction>-0.4 0.3 -0.9</direction></light>

    <model name="ground_plane"><static>true</static><link name="link">
      <collision name="c"><geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry></collision>
      <visual name="v"><geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
        <material><ambient>0.05 0.07 0.10 1</ambient><diffuse>0.07 0.09 0.13 1</diffuse></material></visual>
    </link></model>

    <model name="r1">
      <pose>1.5 3.0 0.1 0 0 0.0</pose>
      <link name="base">
        <inertial><mass>2.0</mass><inertia><ixx>0.05</ixx><iyy>0.05</iyy><izz>0.08</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="c"><pose>0 0 0.12 0 0 0</pose><geometry><box><size>0.6 0.4 0.22</size></box></geometry></collision>
        <visual name="v"><pose>0 0 0.12 0 0 0</pose><geometry><box><size>0.6 0.4 0.22</size></box></geometry>
          <material><ambient>0.13 0.55 0.77 1</ambient><diffuse>0.22 0.74 0.93 1</diffuse><specular>0.3 0.3 0.3 1</specular></material></visual>
        <visual name="nose"><pose>0.26 0 0.2 0 0 0</pose><geometry><box><size>0.12 0.2 0.1</size></box></geometry>
          <material><ambient>0.9 0.95 1 1</ambient><diffuse>0.9 0.95 1 1</diffuse></material></visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <topic>/model/r1/cmd_vel</topic></plugin>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose><publish_model_pose>true</publish_model_pose>
        <use_pose_vector_msg>false</use_pose_vector_msg><static_publisher>false</static_publisher>
        <update_frequency>30</update_frequency></plugin>
    </model>
    <model name="r2">
      <pose>1.5 5.0 0.1 0 0 0.0</pose>
      <link name="base">
        <inertial><mass>2.0</mass><inertia><ixx>0.05</ixx><iyy>0.05</iyy><izz>0.08</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="c"><pose>0 0 0.12 0 0 0</pose><geometry><box><size>0.6 0.4 0.22</size></box></geometry></collision>
        <visual name="v"><pose>0 0 0.12 0 0 0</pose><geometry><box><size>0.6 0.4 0.22</size></box></geometry>
          <material><ambient>0.13 0.55 0.77 1</ambient><diffuse>0.22 0.74 0.93 1</diffuse><specular>0.3 0.3 0.3 1</specular></material></visual>
        <visual name="nose"><pose>0.26 0 0.2 0 0 0</pose><geometry><box><size>0.12 0.2 0.1</size></box></geometry>
          <material><ambient>0.9 0.95 1 1</ambient><diffuse>0.9 0.95 1 1</diffuse></material></visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <topic>/model/r2/cmd_vel</topic></plugin>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose><publish_model_pose>true</publish_model_pose>
        <use_pose_vector_msg>false</use_pose_vector_msg><static_publisher>false</static_publisher>
        <update_frequency>30</update_frequency></plugin>
    </model>
    <model name="r3">
      <pose>1.5 7.0 0.1 0 0 0.0</pose>
      <link name="base">
        <inertial><mass>2.0</mass><inertia><ixx>0.05</ixx><iyy>0.05</iyy><izz>0.08</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="c"><pose>0 0 0.12 0 0 0</pose><geometry><box><size>0.6 0.4 0.22</size></box></geometry></collision>
        <visual name="v"><pose>0 0 0.12 0 0 0</pose><geometry><box><size>0.6 0.4 0.22</size></box></geometry>
          <material><ambient>0.13 0.55 0.77 1</ambient><diffuse>0.22 0.74 0.93 1</diffuse><specular>0.3 0.3 0.3 1</specular></material></visual>
        <visual name="nose"><pose>0.26 0 0.2 0 0 0</pose><geometry><box><size>0.12 0.2 0.1</size></box></geometry>
          <material><ambient>0.9 0.95 1 1</ambient><diffuse>0.9 0.95 1 1</diffuse></material></visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <topic>/model/r3/cmd_vel</topic></plugin>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose><publish_model_pose>true</publish_model_pose>
        <use_pose_vector_msg>false</use_pose_vector_msg><static_publisher>false</static_publisher>
        <update_frequency>30</update_frequency></plugin>
    </model>
    <model name="r4">
      <pose>1.5 9.0 0.1 0 0 0.0</pose>
      <link name="base">
        <inertial><mass>2.0</mass><inertia><ixx>0.05</ixx><iyy>0.05</iyy><izz>0.08</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="c"><pose>0 0 0.12 0 0 0</pose><geometry><box><size>0.6 0.4 0.22</size></box></geometry></collision>
        <visual name="v"><pose>0 0 0.12 0 0 0</pose><geometry><box><size>0.6 0.4 0.22</size></box></geometry>
          <material><ambient>0.13 0.55 0.77 1</ambient><diffuse>0.22 0.74 0.93 1</diffuse><specular>0.3 0.3 0.3 1</specular></material></visual>
        <visual name="nose"><pose>0.26 0 0.2 0 0 0</pose><geometry><box><size>0.12 0.2 0.1</size></box></geometry>
          <material><ambient>0.9 0.95 1 1</ambient><diffuse>0.9 0.95 1 1</diffuse></material></visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <topic>/model/r4/cmd_vel</topic></plugin>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose><publish_model_pose>true</publish_model_pose>
        <use_pose_vector_msg>false</use_pose_vector_msg><static_publisher>false</static_publisher>
        <update_frequency>30</update_frequency></plugin>
    </model>
    <model name="l1">
      <pose>14.5 3.3 0.1 0 0 3.141592653589793</pose>
      <link name="base">
        <inertial><mass>2.0</mass><inertia><ixx>0.05</ixx><iyy>0.05</iyy><izz>0.08</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="c"><pose>0 0 0.12 0 0 0</pose><geometry><box><size>0.6 0.4 0.22</size></box></geometry></collision>
        <visual name="v"><pose>0 0 0.12 0 0 0</pose><geometry><box><size>0.6 0.4 0.22</size></box></geometry>
          <material><ambient>0.80 0.55 0.10 1</ambient><diffuse>0.98 0.75 0.20 1</diffuse><specular>0.3 0.3 0.3 1</specular></material></visual>
        <visual name="nose"><pose>0.26 0 0.2 0 0 0</pose><geometry><box><size>0.12 0.2 0.1</size></box></geometry>
          <material><ambient>1 0.97 0.9 1</ambient><diffuse>1 0.97 0.9 1</diffuse></material></visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <topic>/model/l1/cmd_vel</topic></plugin>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose><publish_model_pose>true</publish_model_pose>
        <use_pose_vector_msg>false</use_pose_vector_msg><static_publisher>false</static_publisher>
        <update_frequency>30</update_frequency></plugin>
    </model>
    <model name="l2">
      <pose>14.5 5.3 0.1 0 0 3.141592653589793</pose>
      <link name="base">
        <inertial><mass>2.0</mass><inertia><ixx>0.05</ixx><iyy>0.05</iyy><izz>0.08</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="c"><pose>0 0 0.12 0 0 0</pose><geometry><box><size>0.6 0.4 0.22</size></box></geometry></collision>
        <visual name="v"><pose>0 0 0.12 0 0 0</pose><geometry><box><size>0.6 0.4 0.22</size></box></geometry>
          <material><ambient>0.80 0.55 0.10 1</ambient><diffuse>0.98 0.75 0.20 1</diffuse><specular>0.3 0.3 0.3 1</specular></material></visual>
        <visual name="nose"><pose>0.26 0 0.2 0 0 0</pose><geometry><box><size>0.12 0.2 0.1</size></box></geometry>
          <material><ambient>1 0.97 0.9 1</ambient><diffuse>1 0.97 0.9 1</diffuse></material></visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <topic>/model/l2/cmd_vel</topic></plugin>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose><publish_model_pose>true</publish_model_pose>
        <use_pose_vector_msg>false</use_pose_vector_msg><static_publisher>false</static_publisher>
        <update_frequency>30</update_frequency></plugin>
    </model>
    <model name="l3">
      <pose>14.5 7.3 0.1 0 0 3.141592653589793</pose>
      <link name="base">
        <inertial><mass>2.0</mass><inertia><ixx>0.05</ixx><iyy>0.05</iyy><izz>0.08</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="c"><pose>0 0 0.12 0 0 0</pose><geometry><box><size>0.6 0.4 0.22</size></box></geometry></collision>
        <visual name="v"><pose>0 0 0.12 0 0 0</pose><geometry><box><size>0.6 0.4 0.22</size></box></geometry>
          <material><ambient>0.80 0.55 0.10 1</ambient><diffuse>0.98 0.75 0.20 1</diffuse><specular>0.3 0.3 0.3 1</specular></material></visual>
        <visual name="nose"><pose>0.26 0 0.2 0 0 0</pose><geometry><box><size>0.12 0.2 0.1</size></box></geometry>
          <material><ambient>1 0.97 0.9 1</ambient><diffuse>1 0.97 0.9 1</diffuse></material></visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <topic>/model/l3/cmd_vel</topic></plugin>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose><publish_model_pose>true</publish_model_pose>
        <use_pose_vector_msg>false</use_pose_vector_msg><static_publisher>false</static_publisher>
        <update_frequency>30</update_frequency></plugin>
    </model>
    <model name="l4">
      <pose>14.5 9.3 0.1 0 0 3.141592653589793</pose>
      <link name="base">
        <inertial><mass>2.0</mass><inertia><ixx>0.05</ixx><iyy>0.05</iyy><izz>0.08</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="c"><pose>0 0 0.12 0 0 0</pose><geometry><box><size>0.6 0.4 0.22</size></box></geometry></collision>
        <visual name="v"><pose>0 0 0.12 0 0 0</pose><geometry><box><size>0.6 0.4 0.22</size></box></geometry>
          <material><ambient>0.80 0.55 0.10 1</ambient><diffuse>0.98 0.75 0.20 1</diffuse><specular>0.3 0.3 0.3 1</specular></material></visual>
        <visual name="nose"><pose>0.26 0 0.2 0 0 0</pose><geometry><box><size>0.12 0.2 0.1</size></box></geometry>
          <material><ambient>1 0.97 0.9 1</ambient><diffuse>1 0.97 0.9 1</diffuse></material></visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <topic>/model/l4/cmd_vel</topic></plugin>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose><publish_model_pose>true</publish_model_pose>
        <use_pose_vector_msg>false</use_pose_vector_msg><static_publisher>false</static_publisher>
        <update_frequency>30</update_frequency></plugin>
    </model>

    <model name="rec_camera"><static>true</static><pose>8 -3.5 12.5 0 0.80 1.5707</pose>
      <link name="link"><sensor name="rec" type="camera">
        <camera><horizontal_fov>1.02</horizontal_fov><image><width>1000</width><height>640</height></image><clip><near>0.1</near><far>120</far></clip></camera>
        <always_on>1</always_on><update_rate>30</update_rate><topic>rec_camera</topic>
      </sensor></link>
    </model>
  </world>
</sdf>
