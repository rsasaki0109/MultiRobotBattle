Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Plane Cell Count: 20
      Color: 160; 160; 164
    - Class: rviz_default_plugins/MarkerArray
      Name: Agents
      Enabled: true
      Topic:
        Value: /coordination/markers
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
  Global Options:
    Fixed Frame: map
    Background Color: 11; 14; 20
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 14
      Focal Point:
        X: 2
        Y: 1.5
        Z: 0
      Pitch: 1.4
      Yaw: 0.785
Window Geometry:
  Height: 700
  Width: 1000
