<?xml version="1.0"?>
<package format="3">
  <name>mrn_coord</name>
  <version>0.1.0</version>
  <description>Multi-robot coordination layer: MAPF planning, formation control, and cooperative coverage for multirobot-navigation.</description>
  <maintainer email="maintainers@example.com">multirobot-navigation maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>mrn_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
