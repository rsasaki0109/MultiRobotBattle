Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Plane Cell Count: 20
      Color: 160; 160; 164
    - Class: rviz_default_plugins/MarkerArray
      Name: World
      Enabled: true
      Topic:
        Value: /sim/markers
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
  Global Options:
    Fixed Frame: map
    Background Color: 11; 14; 20
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 18
      Focal Point:
        X: 6
        Y: 4
        Z: 0
      Pitch: 1.45
      Yaw: 1.57
Window Geometry:
  Height: 720
  Width: 1000
